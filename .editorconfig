root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{rs,py}]
indent_style = space
indent_size = 4
max_line_length = 120

[*.{yml,yaml,toml}]
indent_style = space
indent_size = 2

[tests/fixtures/**]
insert_final_newline = unset
trim_trailing_whitespace = unset
